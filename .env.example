# Database connection string
# Format for PostgreSQL: postgresql://user:password@host:port/dbname
# Format for SQLite:     sqlite:///./app.db
DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/Rewards"

# JWT Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY="your-secret-key-change-in-production"

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=your-bucket-name
# Full GCS service account credentials as a JSON string (one line)
# Get this from your GCS service account key file and convert it to a single line
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key":"..."}
GOOGLE_APPLICATION_CREDENTIALS=app/gcs-service-account.json
GCS_SIGNED_URL_EXPIRES_SECONDS=3600
